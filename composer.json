{
	"name": "hotochan123/story2bpmn",
	"description": "Nextcloud app: tell a process as a story, get readable BPMN 2.0",
	"license": "AGPL-3.0-or-later",
	"type": "project",
	"autoload": {
		"psr-4": {
			"OCA\\Story2Bpmn\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Story2Bpmn\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/",
			"NCU\\": "vendor/nextcloud/ocp/NCU/"
		}
	},
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable34",
		"phpunit/phpunit": "^11.5"
	},
	"scripts": {
		"test:unit": "phpunit -c tests/phpunit.xml"
	},
	"config": {
		"platform": {
			"php": "8.2"
		},
		"sort-packages": true
	}
}
