<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmnc="urn:bpmn-core:geschichte" id="Definitions_P" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-core" exporterVersion="1" bpmnc:geschichte="[{&#34;zug&#34;:&#34;start&#34;,&#34;text&#34;:&#34;Bestellung geht ein&#34;,&#34;stelle&#34;:&#34;Vertrieb&#34;,&#34;art&#34;:&#34;nachricht&#34;,&#34;prozess&#34;:&#34;Bestellung&#34;},{&#34;zug&#34;:&#34;schritt&#34;,&#34;text&#34;:&#34;Bestellung prüfen&#34;,&#34;stelle&#34;:&#34;Vertrieb&#34;},{&#34;zug&#34;:&#34;wenn&#34;,&#34;frage&#34;:&#34;Ware auf Lager?&#34;,&#34;ja&#34;:&#34;ja&#34;,&#34;nein&#34;:&#34;nein&#34;},{&#34;zug&#34;:&#34;schritt&#34;,&#34;text&#34;:&#34;Ware kommissionieren&#34;,&#34;stelle&#34;:&#34;Lager&#34;,&#34;system&#34;:&#34;SAP&#34;},{&#34;zug&#34;:&#34;schritt&#34;,&#34;text&#34;:&#34;Ware versenden&#34;,&#34;stelle&#34;:&#34;Lager&#34;,&#34;frist&#34;:&#34;2 Tage&#34;},{&#34;zug&#34;:&#34;ausnahme&#34;,&#34;text&#34;:&#34;3 Tage ohne Zustellung&#34;,&#34;art&#34;:&#34;frist&#34;,&#34;laeuftWeiter&#34;:&#34;ja&#34;},{&#34;zug&#34;:&#34;schritt&#34;,&#34;text&#34;:&#34;Kunde informieren&#34;,&#34;stelle&#34;:&#34;Vertrieb&#34;},{&#34;zug&#34;:&#34;ende&#34;,&#34;text&#34;:&#34;Kunde informiert&#34;,&#34;art&#34;:&#34;&#34;},{&#34;zug&#34;:&#34;wechsel&#34;,&#34;zu&#34;:1},{&#34;zug&#34;:&#34;schritt&#34;,&#34;text&#34;:&#34;Ware nachbestellen&#34;,&#34;stelle&#34;:&#34;Einkauf&#34;},{&#34;zug&#34;:&#34;warten&#34;,&#34;text&#34;:&#34;Lieferung&#34;,&#34;art&#34;:&#34;nachricht&#34;},{&#34;zug&#34;:&#34;weiter&#34;,&#34;ziel&#34;:&#34;Schritt_4&#34;},{&#34;zug&#34;:&#34;ende&#34;,&#34;text&#34;:&#34;Versandbestätigung&#34;,&#34;art&#34;:&#34;nachricht&#34;}]">
  <bpmn:collaboration id="P_collaboration">
    <bpmn:participant id="P_pool" name="Bestellung" processRef="P" />
  </bpmn:collaboration>
  <bpmn:process id="P" name="Bestellung" isExecutable="false">
    <bpmn:documentation>ES BEGINNT mit Nachricht: Bestellung geht ein bei Vertrieb.
Vertrieb soll Bestellung prüfen.
WENN Ware auf Lager?
→ ja:
  Lager soll Ware kommissionieren in SAP.
  Lager soll Ware versenden, Frist 2 Tage.
  FALLS 3 Tage ohne Zustellung, Schritt läuft weiter:
    Vertrieb soll Kunde informieren.
    ENDE: Kunde informiert.
SONST → nein:
  Einkauf soll Ware nachbestellen.
  WARTEN AUF Lieferung.
  WEITER BEI Ware kommissionieren.
WEITER AUF DEM WEG „Ware auf Lager?“ → ja:
  ENDE mit Nachricht: Versandbestätigung.</bpmn:documentation>
    <bpmn:laneSet id="P_lanes">
      <bpmn:lane id="Bahn_1" name="Vertrieb">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Schritt_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Wenn_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Schritt_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende_8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Bahn_2" name="Lager">
        <bpmn:flowNodeRef>Schritt_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Schritt_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Zusammen_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende_12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Bahn_3" name="Einkauf">
        <bpmn:flowNodeRef>Schritt_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Warten_10</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Bestellung geht ein">
      <bpmn:outgoing>f_Start_1__Schritt_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_1_msg" />
    </bpmn:startEvent>
    <bpmn:task id="Schritt_2" name="Bestellung prüfen">
      <bpmn:incoming>f_Start_1__Schritt_2</bpmn:incoming>
      <bpmn:outgoing>f_Schritt_2__Wenn_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Wenn_3" name="Ware auf Lager?" default="f_Wenn_3__Schritt_9">
      <bpmn:incoming>f_Schritt_2__Wenn_3</bpmn:incoming>
      <bpmn:outgoing>f_Wenn_3__Schritt_4</bpmn:outgoing>
      <bpmn:outgoing>f_Wenn_3__Schritt_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Schritt_4" name="Ware kommissionieren">
      <bpmn:documentation>System: SAP</bpmn:documentation>
      <bpmn:incoming>f_Zusammen_11__Schritt_4</bpmn:incoming>
      <bpmn:outgoing>f_Schritt_4__Schritt_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Schritt_5" name="Ware versenden">
      <bpmn:documentation>Frist: 2 Tage</bpmn:documentation>
      <bpmn:incoming>f_Schritt_4__Schritt_5</bpmn:incoming>
      <bpmn:outgoing>f_Schritt_5__Ende_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="Ausnahme_6" name="3 Tage ohne Zustellung" cancelActivity="false" attachedToRef="Schritt_5">
      <bpmn:outgoing>f_Ausnahme_6__Schritt_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Ausnahme_6_timer" />
    </bpmn:boundaryEvent>
    <bpmn:task id="Schritt_7" name="Kunde informieren">
      <bpmn:incoming>f_Ausnahme_6__Schritt_7</bpmn:incoming>
      <bpmn:outgoing>f_Schritt_7__Ende_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Ende_8" name="Kunde informiert">
      <bpmn:incoming>f_Schritt_7__Ende_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Schritt_9" name="Ware nachbestellen">
      <bpmn:incoming>f_Wenn_3__Schritt_9</bpmn:incoming>
      <bpmn:outgoing>f_Schritt_9__Warten_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Warten_10" name="Lieferung">
      <bpmn:incoming>f_Schritt_9__Warten_10</bpmn:incoming>
      <bpmn:outgoing>f_Warten_10__Zusammen_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Warten_10_msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Zusammen_11">
      <bpmn:incoming>f_Wenn_3__Schritt_4</bpmn:incoming>
      <bpmn:incoming>f_Warten_10__Zusammen_11</bpmn:incoming>
      <bpmn:outgoing>f_Zusammen_11__Schritt_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Ende_12" name="Versandbestätigung">
      <bpmn:incoming>f_Schritt_5__Ende_12</bpmn:incoming>
      <bpmn:messageEventDefinition id="Ende_12_msg" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_Start_1__Schritt_2" sourceRef="Start_1" targetRef="Schritt_2" />
    <bpmn:sequenceFlow id="f_Schritt_2__Wenn_3" sourceRef="Schritt_2" targetRef="Wenn_3" />
    <bpmn:sequenceFlow id="f_Wenn_3__Schritt_4" name="ja" sourceRef="Wenn_3" targetRef="Zusammen_11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ja</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_Schritt_4__Schritt_5" sourceRef="Schritt_4" targetRef="Schritt_5" />
    <bpmn:sequenceFlow id="f_Ausnahme_6__Schritt_7" sourceRef="Ausnahme_6" targetRef="Schritt_7" />
    <bpmn:sequenceFlow id="f_Schritt_7__Ende_8" sourceRef="Schritt_7" targetRef="Ende_8" />
    <bpmn:sequenceFlow id="f_Wenn_3__Schritt_9" name="nein" sourceRef="Wenn_3" targetRef="Schritt_9" />
    <bpmn:sequenceFlow id="f_Schritt_9__Warten_10" sourceRef="Schritt_9" targetRef="Warten_10" />
    <bpmn:sequenceFlow id="f_Zusammen_11__Schritt_4" sourceRef="Zusammen_11" targetRef="Schritt_4" />
    <bpmn:sequenceFlow id="f_Warten_10__Zusammen_11" sourceRef="Warten_10" targetRef="Zusammen_11" />
    <bpmn:sequenceFlow id="f_Schritt_5__Ende_12" sourceRef="Schritt_5" targetRef="Ende_12" />
  </bpmn:process>
